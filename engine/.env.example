DATABASE_URL=postgres://postgres:<password>@127.0.0.1:5432/engine
RPC_URL=https://rpc.mainnet.chain.robinhood.com
TOKEN=0x...                 # $JEV after launch
LAUNCH_BLOCK=               # runbook §4.4: the Transfer index starts here
CONFIRMATIONS=20            # ~2s at 0.105 s/block
LOG_CHUNK=20000             # maximum width of an eth_getLogs before bisection
POLL_MS=5000                # only for `index --loop`
V4_LOG_CHUNK=3000             # PoolManager: ~2.6 swaps/block against the 10,000-log cap
V4_START_BLOCK=             # where to start reading the PoolManager: covering 48h before the first batch is enough

# CallLedger (open-questions)
LEDGER_RPC_URL=             # empty = RPC_URL; testnet or anvil in trials
CALL_LEDGER=0x...
KEEPER_PK=0x...             # the CallLedger publisher key, and the FeeRouter keeper (claim + processSwap)
CALL_WINDOW_SEC=7200
MIN_CALL_WINDOW_SEC=1800
EPOCH_MARGIN_SEC=300
HORIZON_SEC=21600
QUESTIONS_PER_BATCH=10
MIN_SWAPS_LAST_HOUR=10
MIN_SWAPS_LAST_6H=60

# Rewards (close-epoch)
REWARDS_DISTRIBUTOR=0x...
SCORER_PK=0x...             # key DISTINCT from the keeper (spec §9.1)
LEDGER_START_BLOCK=         # CallLedger deploy block
EXCLUDE=0x...,0x...         # TEAM_WALLET, team wallets, FeeRouter, RewardsDistributor, pools, 0x...dEaD
SCORE_REFERENCE=baseline    # baseline | model (spec §10.3, to be decided)
TOP_FRACTION=0.1            # rewarded: the top 10% with score > 0
EPOCH_BUDGET=               # cap in wei; empty = the contract maximum (20% of the free balance)
HOST=0.0.0.0                # Railway: all interfaces. Locally: 127.0.0.1
PORT=8080
HEALTH_MAX_AGE_SEC=600      # blind beyond this: /health 503 and the process exits with 3
MAX_LAG_BLOCKS=2000         # index further behind than this: no new questions
MAX_BLOCKS_PER_CYCLE=30000
MODEL_BUDGET_MS=150000      # the model loop of one batch stops here and opens what it has: a slow Jev must not make the engine look blind
PRUNE_KEEP_BLOCKS=5800000   # swaps older than this many blocks behind the newest are deleted (~7 days); candidates need 48h, resolution 6h
MODEL=none                  # none | jev | stub (stub refused on mainnet)
TYPESAFE_API_KEY=           # for MODEL=jev
JEV_MODEL=jev-1.13.0
TYPESAFE_BASE_URL=          # empty = https://api.typesafe.ai

# Treasury (fees): collect the Pons escrow, then one buyback per epoch
PONS_ESCROW_ADAPTER=0x...    # the launch's fee recipient (word 3 of the launch record)
FEE_ROUTER=0x...
MIN_CLAIM_WEI=500000000000000     # 0.0005 ETH
MIN_SWAP_WEI=5000000000000000     # 0.005 ETH; below it the buyback waits for the next epoch
SWAP_SLIPPAGE_BPS=300             # on top of the hook cut, which is read on-chain every time

# Announcer: the game's public voice (spec: docs/superpowers/specs/2026-09-21-announcer-soul-design.md)
ANNOUNCE_MODE=off           # off | test (everything to TELEGRAM_TEST_CHAT_ID) | live
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=        # live: the announcements channel (the bot must be an admin)
TELEGRAM_TEST_CHAT_ID=      # test: one private chat that receives every post, both channels' versions
PUBLIC_SITE_URL=https://www.jevsaidit.com
X_DAILY_CAP=6                # per UTC day; 2 slots are kept for the epoch verdict and 1 for the buyback
# X, OAuth 1.0a user context of @jevsaidit (developer app with write access). All four or none:
# without them X posts are recorded as `unconfigured` and never sent later.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
FEED_CACHE_SEC=15
