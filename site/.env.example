# All optional. Without them, the site shows the pre-launch state.

# Base URL of the Verdict Engine's public feed (spec §9.4), no trailing slash.
# The site queries it server-side via /api/feed/*, so there is no CORS to configure on the engine.
ENGINE_FEED_URL=

# Address of the $JEV token. Fill it in ONLY once the contract is public:
# while it's empty the site says the address doesn't exist yet, and /api/feed/config stays closed.
NEXT_PUBLIC_TOKEN_ADDRESS=

# The 24h timelock that owns the FeeRouter and the RewardsDistributor after the handover.
# Printed in "Where the fees go" when set; the page states the design (no address) otherwise.
NEXT_PUBLIC_TIMELOCK_ADDRESS=

# Ticker shown everywhere (default JEV, without "$").
NEXT_PUBLIC_TICKER=

# Canonical site URL, for metadata, Open Graph and the printed commands. Always the www host.
NEXT_PUBLIC_SITE_URL=https://www.jevsaidit.com

# Optional social links.
NEXT_PUBLIC_TELEGRAM_URL=

# The dev wallet and its launch buy, printed in the footer. Set them at launch together with the token.
NEXT_PUBLIC_DEV_WALLET=
NEXT_PUBLIC_DEV_SHARE=
