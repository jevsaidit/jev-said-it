# All optional. Without them, the site shows the pre-launch state.

# Base URL of the Verdict Engine's public feed (spec §9.4), no trailing slash.
# The site queries it server-side via /api/feed/*, so there is no CORS to configure on the engine.
ENGINE_FEED_URL=

# Address of the $JEVSAIDIT token. Fill it in ONLY once the contract is public:
# while it's empty the site says the address doesn't exist yet.
NEXT_PUBLIC_TOKEN_ADDRESS=

# Ticker shown everywhere (default JEVSAIDIT, without "$").
NEXT_PUBLIC_TICKER=

# Canonical site URL, for metadata and Open Graph.
NEXT_PUBLIC_SITE_URL=https://jevsaidit.com

# Optional social links.
NEXT_PUBLIC_TELEGRAM_URL=
